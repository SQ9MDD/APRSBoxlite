{
  "name": "aprsbox-lite",
  "productName": "aprsbox-lite",
  "version": "1.0.0",
  "private": true,
  "description": "My Electron application description",
  "keywords": [],
  "license": "MIT",
  "author": {
    "name": "Rysiek Labus (SQ9MDD)",
    "email": "rysieklabus@gmail.com"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:win": "electron-forge package --platform=win32 --arch=x64 && electron-builder --win --x64 --prepackaged out/aprsbox-lite-win32-x64 --publish never",
    "release": "electron-forge release",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "test:config": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@types/leaflet": "^1.9.22",
    "electron": "45.4.1",
    "electron-builder": "^26.18.0",
    "leaflet": "^1.9.4",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.94.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
